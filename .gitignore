# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Supabase state
supabase/.temp/

# Temporary backups
*.backup-*
*.before-*
src/app/globals.before-ehealth-redesign.css
task-performance-patch.ps1
login-temp.txt

# Local lockfile backups
package-lock.before-*.json

# Local security audit exports
security-*.txt
security-*.csv
